        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "¿Cuál es el pedido mínimo para envío sin costo en Medellín?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "El pedido mínimo es $200,000 COP para envío sin costo adicional en toda el área metropolitana de Medellín. Pedidos menores tienen recargo de $15,000 COP por transporte."
            }
          },
          {
            "@type": "Question",
            "name": "¿Entregan los fines de semana en Medellín?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Entregas de lunes a viernes. Pedidos urgentes para sábado deben solicitarse antes del jueves al mediodía. No realizamos entregas domingos ni festivos."
            }
          },
          {
            "@type": "Question",
            "name": "¿Puedo recoger directamente en bodega en Medellín?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Actualmente no tenemos punto de retiro en Medellín. Todas las ventas son con entrega programada. Nuestra bodega principal está en Bogotá."
            }
          },
          {
            "@type": "Question",
            "name": "¿Hay servicio técnico para máquinas en Medellín?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sí, contamos con técnico certificado en Medellín para instalación, capacitación y mantenimiento de maquinaria Coldelite, Valmar y vitrinas EasyBest. Visitas programadas con 48h de anticipación."
            }
          },
          {
            "@type": "Question",
            "name": "¿Qué formas de pago aceptan en Medellín?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Transferencia bancaria, contraentrega (efectivo o datáfono), consignación. Para clientes frecuentes ofrecemos crédito a 15-30 días."
            }
          }
        ]
